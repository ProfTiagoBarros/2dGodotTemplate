; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot 2D Template"
config/description="Template modular para jogos 2D (PC + Mobile)."
config/version="0.1.0"
run/main_scene="res://ui/main_menu/main_menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Log="*res://autoloads/log.gd"
EventBus="*res://autoloads/event_bus.gd"
Settings="*res://autoloads/settings.gd"
SaveSystem="*res://autoloads/save_system.gd"
AudioManager="*res://autoloads/audio_manager.gd"
GameFeel="*res://autoloads/game_feel.gd"
InputManager="*res://autoloads/input_manager.gd"
InputBindings="*res://autoloads/input_bindings.gd"
SceneLoader="*res://autoloads/scene_loader.gd"
DebugTools="*res://autoloads/debug_tools.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://ui/theme/main_theme.tres"

